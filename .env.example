# Backend
APP_NAME="SpecGuard AI"
API_PREFIX="/api/v1"
CORS_ORIGINS='["http://localhost:3000"]'
MAX_UPLOAD_MB=10

# Groq — main analysis path. Free key from https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"
# gpt-oss models reason before answering; low keeps that spend off the JSON budget.
GROQ_REASONING_EFFORT="low"

# Tier 3 — Google Gemini. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
USE_LLM=false

# Supabase (backend uses the secret/service_role key, never the publishable/anon key)
SUPABASE_URL=""
SUPABASE_KEY=""
